@Metadata.layer: #CORE
annotate entity ZIK_C_CREDAPP with
{
  @UI.facet: [ { id:       'Application',
                 purpose:  #STANDARD,
                 type:     #IDENTIFICATION_REFERENCE,
                 label:    'General',
                 position: 10 },
               { id:              'Terms',
                 purpose:         #STANDARD,
                 type:            #FIELDGROUP_REFERENCE,
                 label:           'Loan Terms',
                 position:        20,
                 targetQualifier: 'Terms' },
               { id:              'Calculation',
                 purpose:         #STANDARD,
                 type:            #FIELDGROUP_REFERENCE,
                 label:           'Calculation',
                 position:        30,
                 targetQualifier: 'Calculation' },
               { id:              'Decision',
                 purpose:         #STANDARD,
                 type:            #FIELDGROUP_REFERENCE,
                 label:           'Decision',
                 position:        40,
                 targetQualifier: 'Decision' },
               { id:            'Income',
                 purpose:       #STANDARD,
                 type:          #LINEITEM_REFERENCE,
                 label:         'Income Sources',
                 position:      50,
                 targetElement: '_Income' } ]

  @UI: { lineItem:       [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'Submit',  label: 'Submit' },
                           { type: #FOR_ACTION, dataAction: 'Approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'Reject',  label: 'Reject' } ],
         identification: [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'Submit',  label: 'Submit' },
                           { type: #FOR_ACTION, dataAction: 'Approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'Reject',  label: 'Reject' } ] }
  ApplicationId;

  @UI: { lineItem:       [ { position: 20 } ],
         identification: [ { position: 20 } ],
         selectionField: [ { position: 20 } ] }
  CustomerId;

  @UI: { lineItem:       [ { position: 30 } ],
         identification: [ { position: 30 } ],
         selectionField: [ { position: 30 } ] }
  ProductId;

  @UI: { lineItem:       [ { position: 60, criticality: 'StatusCriticality' } ],
         identification: [ { position: 40, criticality: 'StatusCriticality' } ],
         selectionField: [ { position: 10 } ] }
  Status;

  @UI.fieldGroup: [ { qualifier: 'Terms', position: 10 } ]
  @UI.lineItem:   [ { position: 40 } ]
  Amount;

  @UI.fieldGroup: [ { qualifier: 'Terms', position: 30 } ]
  @UI.lineItem:   [ { position: 50 } ]
  TermMonths;

  @UI.fieldGroup: [ { qualifier: 'Terms', position: 40 } ]
  InterestRate;

  @UI.fieldGroup: [ { qualifier: 'Calculation', position: 10 } ]
  @UI.lineItem:   [ { position: 70 } ]
  MonthlyPayment;

  @UI.fieldGroup: [ { qualifier: 'Calculation', position: 20 } ]
  TotalIncome;

  @UI.fieldGroup: [ { qualifier: 'Calculation', position: 30 } ]
  TotalCost;

  @UI.fieldGroup: [ { qualifier: 'Calculation', position: 40 } ]
  Overpayment;

  @UI.fieldGroup: [ { qualifier: 'Decision', position: 10 } ]
  SubmittedAt;

  @UI.fieldGroup: [ { qualifier: 'Decision', position: 20 } ]
  DecidedAt;

  @UI.fieldGroup: [ { qualifier: 'Decision', position: 30 } ]
  DecidedBy;
}
